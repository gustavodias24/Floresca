<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco_laranja"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco_laranja"
        android:orientation="vertical"
        android:padding="8dp"
        tools:context=".IndexActivity">

        <ImageButton
            android:id="@+id/voltar1"
            android:layout_width="30sp"
            android:layout_height="30sp"
            android:layout_gravity="start"
            android:background="@drawable/rounded_back"
            android:scaleType="fitCenter"
            android:tint="#050505"
            app:srcCompat="@drawable/voltaricon" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            app:srcCompat="@drawable/logo2" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="@color/laranja"
            android:gravity="center"
            android:text="Exercícios de&#10; relaxamento"
            android:textColor="#352236"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/relaxamenticon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/autoconfianca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Autoconfiança e aceitação - 10 minutos"
                    android:textColor="@color/roxo_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_autoconfianca"
                    android:layout_width="45sp"
                    android:layout_height="45sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_botao_audio_redondo"
                    android:contentDescription="Tocar ou pausar áudio de autoconfiança"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/play" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/relaxamenticon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/autoestima"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Autoestima e amor próprio - 5 minutos"
                    android:textColor="@color/roxo_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_autoestima"
                    android:layout_width="45sp"
                    android:layout_height="45sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_botao_audio_redondo"
                    android:contentDescription="Tocar ou pausar áudio de autoestima"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/play" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/relaxamenticon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/livre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Livre da ansiedade - 10 minutos"
                    android:textColor="@color/roxo_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_livre"
                    android:layout_width="45sp"
                    android:layout_height="45sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_botao_audio_redondo"
                    android:contentDescription="Tocar ou pausar áudio livre da ansiedade"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/play" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/relaxamenticon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A cura está em você - 5 minutos"
                    android:textColor="@color/roxo_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_cura"
                    android:layout_width="45sp"
                    android:layout_height="45sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_botao_audio_redondo"
                    android:contentDescription="Tocar ou pausar áudio a cura está em você"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/play" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:text="Fonte: Raissa Zucal" />

    </LinearLayout>
</ScrollView>